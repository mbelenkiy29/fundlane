FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN node scripts/workers/build.mjs

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends clamav clamav-freshclam ca-certificates poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/.next/document-worker.cjs ./document-worker.cjs
COPY scripts/workers/start.sh ./start.sh
RUN chmod +x start.sh && sed -i '/^Example/d' /etc/clamav/freshclam.conf && mkdir -p /var/lib/clamav && chown -R node:node /app /var/lib/clamav /var/log/clamav && sed -i 's/^DatabaseOwner .*/DatabaseOwner node/' /etc/clamav/freshclam.conf
USER node
ENV NODE_ENV=production MCA_BACKGROUND_JOBS=enabled MCA_DOCUMENT_SCANNER=clamscan MCA_DOCUMENT_STORAGE_PROVIDER=supabase
CMD ["./start.sh"]
