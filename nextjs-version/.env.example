# Required in production. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MCA_DATA_ENCRYPTION_KEY=

# Supabase transaction pooler for Vercel; direct (or session pooler) for controlled migrations.
# Keep both values in the deployment secret store. TLS certificate verification is required.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Bounded server pool. Vercel defaults to 2; workers may use 5.
MCA_DB_POOL_MAX=2
MCA_APP_ORIGIN=http://localhost:3000
# Passwordless email sign-in. Unset or any value except true keeps it disabled.
MCA_MAGIC_LINK_ENABLED=false
# Company self sign-up: open (default, including invalid values) or invite_only.
MCA_SIGNUP_MODE=open
# Set to false to hide the general migrated-account helper on /sign-in; default is shown.
MCA_SHOW_MIGRATED_ACCOUNT_NOTICE=true

# Private Supabase Storage. Filesystem is supported only for isolated local tests.
MCA_DOCUMENT_STORAGE_PROVIDER=supabase
MCA_SUPABASE_DOCUMENT_BUCKET=fundlane-documents
MCA_SUPABASE_QUARANTINE_BUCKET=fundlane-quarantine
MCA_SUPABASE_ASSISTANT_BUCKET=fundlane-assistant
MCA_DOCUMENT_STORAGE_PATH=data/documents
MCA_BACKGROUND_JOBS=enabled
# Unset (or any value other than vercel_cron) leaves the new export cron inert.
MCA_JOB_RUNTIME=
# Unset disables /api/cron/documents. Use vercel_cron only after hosted acceptance.
MCA_DOCUMENT_JOB_RUNTIME=
MCA_INVITATION_JOB_RUNTIME=
# On the external native executor, true limits claims to native document/intake kinds.
MCA_NATIVE_DOCUMENT_EXECUTOR=
# Rich workspace setup guidance and admin diagnostic download; unset/false keeps the five-step checklist.
MCA_SETUP_READINESS_ENABLED=false
# Optional comma-separated eligible Vercel cron kinds. Unset uses export_create,export
# plus auto_submit only when MCA_AUTO_SUBMIT_ENABLED=true. Set only after staging proof.
MCA_JOB_RUNTIME_KINDS=
# Run submission recovery, assistant maintenance, and private Storage cleanup on the jobs cron. Default off.
MCA_JOB_RUNTIME_MAINTENANCE=false
# Recover a saved completed submission attempt into its job and cache. Unset preserves the existing outbox-only behavior.
MCA_SUBMISSION_COMPLETED_ATTEMPT_RECOVERY_ENABLED=false
# Show the per-kind queue snapshot on the platform owner status page. Default off.
MCA_JOB_RUNTIME_STATUS_ENABLED=false

# Supabase browser configuration contains no privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Release tooling only; never deploy these to Vercel runtime.
MCA_DB_RUNTIME_PASSWORD=
MCA_MIGRATION_SOURCE_URL=
MCA_MIGRATION_EXPECTED_PROJECT_REF=
# Local test cluster with CREATE DATABASE, not an application database.
MCA_TEST_DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/postgres

# Google Drive web-server OAuth. Add the callback URL shown here to the Google Cloud OAuth client.
MCA_GOOGLE_DRIVE_CLIENT_ID=
MCA_GOOGLE_DRIVE_CLIENT_SECRET=
# Optional override; defaults to ${MCA_APP_ORIGIN}/api/mca/imports/drive/callback
MCA_GOOGLE_DRIVE_REDIRECT_URI=

# Application invitation/business delivery. Configure Supabase Auth SMTP separately.
MCA_EMAIL_WEBHOOK_URL=
MCA_EMAIL_WEBHOOK_TOKEN=
# Private email launch gates; keep false until synthetic hosted acceptance passes.
MCA_EMAIL_SENDER_VERIFIED=false
MCA_PRIVATE_EMAIL_INTAKE_ENABLED=false
MCA_PRIVATE_EMAIL_DELIVERY_ENABLED=false
MCA_PRIVATE_EMAIL_CRON_ENABLED=false

# Comma-separated browser origins, in addition to MCA_APP_ORIGIN's request origin.
MCA_ALLOWED_ORIGINS=

# Localhost-only recovery previews require both development mode and this explicit switch.
MCA_ALLOW_RECOVERY_PREVIEW=false

# MIC-184: useSend is the email gateway for intake receipts. Inbound mailboxes are
# not issued by useSend; provision a real forwarding address and HMAC webhook.
# Per-workspace API keys are stored encrypted on the integration. These env vars
# are optional workspace-wide fallbacks for receipt sending.
MCA_USESEND_API_KEY=
MCA_USESEND_FROM=
# Optional self-hosted origin; defaults to https://app.usesend.com
MCA_USESEND_BASE_URL=
# Optional Postmark inbound remains available. The account token is used only for
# provider setup when that gateway is selected, not saved in the database.
POSTMARK_ACCOUNT_TOKEN=
# Closing email can use Postmark's send API. The server token is distinct from the
# account token. Keep JSON in the deployment secret store and bind each credential to
# one exact workspace, verified sender record, and provider-confirmed From address:
# [{"workspaceId":"...","senderId":"...","fromAddress":"sender@example.com","serverToken":"...","messageStream":"outbound"}]
MCA_CLOSING_EMAIL_PROVIDER=
MCA_CLOSING_POSTMARK_CONNECTIONS_JSON=[]
# Optional; defaults to Postmark's `outbound` transactional stream.
MCA_CLOSING_POSTMARK_MESSAGE_STREAM=
# Opt in only after provider and operator acceptance. Unset/false retains the
# current closing behavior; true requires reviewed signed evidence before funding.
MCA_CLOSING_VERIFIED_FLOW_ENABLED=false

# Optional Twilio SMS transport. Leaving these unset keeps SMS accounts blocked.
# Public base URL must be one clean HTTPS origin; Twilio signs callbacks against it.
MCA_SMS_PROVIDER=
MCA_SMS_PUBLIC_BASE_URL=
# Workspace-bound credential map. Keep it in the deployment secret store. Every
# sender saved in Connections must exactly match an allowedSenders entry:
# {"workspace-id":{"DEFAULT":{"accountSid":"AC...","apiKeySid":"SK...","apiKeySecret":"...","authToken":"...","allowedSenders":["+12125551212","MG..."]}}}
MCA_SMS_TWILIO_ACCOUNTS_JSON={}

# Optional direct PSF signing. Exact workspace/template bindings are documented in
# docs/milestone-05/docuseal-psf-activation.md. Keep unset until a template is approved.
MCA_DOCUSEAL_PSF_CONNECTIONS_JSON=[]

# PDF extraction; labelled email text and administrator review work without AI.
MCA_DOCUMENT_AI_PROVIDER=
MCA_DOCUMENT_AI_MODEL=
OPENAI_API_KEY=
# Scan originals before document download/processing is enabled.
MCA_DOCUMENT_SCANNER=
# Required only when MCA_DOCUMENT_SCANNER=cloudmersive.
MCA_CLOUDMERSIVE_API_KEY=
# Receipt adapter must authenticate Bearer MCA_INTAKE_RECEIPT_WEBHOOK_TOKEN,
# honor Idempotency-Key, and return JSON {"id":"provider-message-id"}.
# URL alone never enables webhook receipt delivery.
MCA_INTAKE_RECEIPT_WEBHOOK_URL=
MCA_INTAKE_RECEIPT_WEBHOOK_TOKEN=
MCA_INTAKE_WORKER_TOKEN=

# Managed company SMS. Keep activation false until Twilio confirms ISV identity and use case.
MCA_SMS_ISV_APPROVED=false
MCA_SMS_ELIGIBILITY_REFERENCE=
MCA_TWILIO_PRIMARY_PROFILE_SID=
MCA_TWILIO_PARENT_ACCOUNT_SID=
MCA_TWILIO_PARENT_AUTH_TOKEN=
MCA_PLATFORM_OPERATOR_USER_IDS=
MCA_SMS_COMPLIANCE_EMAIL=
# Configure current conservative USD estimates, in cents; no price defaults are assumed.
MCA_SMS_REGISTRATION_ESTIMATE_CENTS=
MCA_SMS_SEGMENT_ESTIMATE_CENTS=
# Random server-only credential for the scheduled SMS worker.
MCA_SMS_JOB_TOKEN=
# Dedicated Vercel SMS cron consumer; exact "true" only. Off until hosted approval.
MCA_SMS_CRON_ENABLED=false

# Explicit test/live company billing mode; keys, prices and portal must match.
MCA_STRIPE_BILLING_ENABLED=false
# Require a card for new-company trials even when Stripe trial settings are unavailable.
# Default false preserves the legacy local-trial fallback.
MCA_TRIAL_REQUIRES_CARD=false
# Stripe Tax stays off until the merchant/accountant approve registrations and tax treatment.
MCA_STRIPE_TAX_ENABLED=false
# Exact "true" lets customers enter Stripe promotion codes in company subscription Checkout.
# Default false preserves the existing Checkout request. Create codes in the Stripe Dashboard.
MCA_STRIPE_PROMOTION_CODES_ENABLED=false
# Optional price verification: exclusive or inclusive; blank preserves existing checks.
MCA_STRIPE_TAX_BEHAVIOR=
# Strict true waits for an authoritative invoice refresh before sending webhook invoice notices
# and shows a failed-payment banner for verified open invoices. Default false preserves current behavior.
MCA_BILLING_VERIFIED_INVOICE_NOTICES=false
# Cross-workspace trial checks. Disabled by default to preserve current Checkout behavior.
MCA_TRIAL_ABUSE_LIMITS_ENABLED=false
MCA_TRIAL_LIMIT_PER_USER=1
MCA_TRIAL_LIMIT_PER_EMAIL=1
# Blank disables domain limits; public email domains are always exempt.
MCA_TRIAL_LIMIT_PER_DOMAIN=
# flag records repeated card fingerprints for operator review; off disables that flag.
# Invalid values log a warning and fall back to flag.
MCA_TRIAL_FINGERPRINT_ACTION=flag
MCA_BILLING_MISSING_STATE_FAIL_CLOSED=false
MCA_BILLING_SEAT_SYNC_ENABLED=false
# Read-only Stripe preview before manual paid increases; exact true and billing enabled required.
MCA_BILLING_MANUAL_SEAT_PREVIEW_ENABLED=false
MCA_BILLING_SEATS_COUNT_PENDING_INVITES=false
# Maximum pending team invitations per workspace while seat sync is enabled.
MCA_BILLING_MAX_PENDING_INVITATIONS=25
MCA_STRIPE_MODE=test
# Enable Stripe trial-end and paused owner emails after staging webhook/email verification.
MCA_STRIPE_TRIAL_LIFECYCLE_ENABLED=false
# Monthly USD $399 base; graduated additional-seat tiers at 9/19/infinity.
STRIPE_BASE_PRICE_ID=
STRIPE_ADDITIONAL_SEAT_PRICE_ID=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION=
# Billing notifications use MCA_EMAIL_WEBHOOK_URL when set; otherwise the existing
# MCA_USESEND_API_KEY / MCA_USESEND_FROM settings deliver directly via UseSend.
# Stripe restricted keys also need charges/refunds/disputes read for console projections.
# Vercel /api/cron/billing, /api/cron/comms, and opt-in /api/cron/jobs and /api/cron/documents bearer credential.
# Comms ticks retry signed webhook outbox rows and send due daily report emails.
# This HTTP contract is runtime-agnostic; do not treat Render as the permanent scheduler.
CRON_SECRET=

# Cutover event capture must use an independent private Supabase bucket.
MCA_MAINTENANCE_MODE=disabled
MCA_MAINTENANCE_SUPABASE_URL=
MCA_MAINTENANCE_SUPABASE_SECRET_KEY=
MCA_MAINTENANCE_CAPTURE_BUCKET=mca-cutover-events
MCA_MAINTENANCE_REPLAY_ALLOWED_ORIGINS=
# Render HTTPS gateway for large signed provider webhooks.
MCA_INGRESS_ORIGIN=

# Marketing demo requests. These three enable the legacy webhook path.
# Receiver must durably accept and atomically deduplicate Idempotency-Key.
# See docs/marketing-site.md. HTTPS only; keep tokens in the secret store.
MCA_DEMO_WEBHOOK_URL=
MCA_DEMO_WEBHOOK_TOKEN=
MCA_MARKETING_PRIVACY_URL=
# Opt in to direct database demo submissions after migration 0056. Unset/false preserves webhook delivery.
MCA_DEMO_DB_SUBMISSIONS_ENABLED=false

# Admin-only configured funder/adapter readiness inventory. Defaults off.
MCA_FUNDER_READINESS_INVENTORY_ENABLED=false
# Allow opted-in submission senders with Google/Microsoft mailbox read grants to ingest replies. Defaults off.
MCA_FUNDER_REPLY_LIVE_INGEST_ENABLED=false
# Guard ambiguous API and email sends until operator reconciliation. Defaults off.
MCA_FUNDER_UNKNOWN_SEND_GUARD_ENABLED=false
# Optional best-effort notification destination; requires MCA_USESEND_API_KEY and MCA_USESEND_FROM.
MCA_DEMO_NOTIFY_EMAIL=
# Enable bounded notification retries after migration 0064. Read-only visibility and initial delivery do not depend on this flag.
MCA_DEMO_VISIBILITY_ENABLED=false
# Existing help-center support address is also the /demo fallback contact.
# Strict opt-in for the /terms and /privacy pages (published without attorney review, Sept 28 2026).
MCA_LEGAL_DRAFT_PAGES_ENABLED=
MCA_SUPPORT_EMAIL=
# Public pricing page, nav link, sitemap, and robots entry; unset/false preserves the private redirect.
MCA_PUBLIC_PRICING_ENABLED=false
# Public marketing roadmap and platform editor; only exactly true enables them. Apply migration 0066 first.
MCA_PUBLIC_ROADMAP_ENABLED=false
# Marketing trial CTA; also requires MCA_SIGNUP_MODE=open.
MCA_MARKETING_TRIAL_CTA_ENABLED=false
# Marketing polish is opt-in; unset/false keeps current font, links, schema and sign-up presentation.
MCA_MARKETING_POLISH_ENABLED=false
# Optional verified legal entity name for the marketing footer; blank renders nothing.
NEXT_PUBLIC_MCA_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_STATUS_PAGE_URL=
NEXT_PUBLIC_ROADMAP_URL=

# Embedded and sidebar assistant. Keep credentials server-side; see docs/deal-assistant.md.
MCA_ASSISTANT_ENABLED=false
# Native assistant on Vercel Node; unset preserves the existing ChatKit gateway.
MCA_ASSISTANT_RUNTIME=
# Dedicated assistant credit/alert cron; only exactly true enables it.
MCA_ASSISTANT_MAINTENANCE_ENABLED=false
MCA_AUTO_SUBMIT_ENABLED=false
MCA_ASSISTANT_MODEL=
# Conversational chat, private memory and artifact features (apply migration 0022 first).
MCA_ASSISTANT_EXPERIENCE_ENABLED=false
MCA_ASSISTANT_WEB_ENABLED=false
MCA_ASSISTANT_FILES_ENABLED=false
# File uploads/outputs require a configured, healthy document scanner and durable storage.
# MCA_DOCUMENT_SCANNER_COMMAND=/path/to/clamscan-wrapper
# One-time assistant credit packs have a separate Stripe webhook.
# Only exactly true opens new Checkout sessions; unset/false keeps purchases hidden.
# Start with Stripe test credentials; retain the webhook secret after disabling
# purchases so already-paid sessions and refunds can still reconcile.
MCA_AI_CREDIT_PURCHASES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# MCA_APP_ORIGIN above is also required for Checkout return URLs.

# Legacy ChatKit service URL is rollback-only; Vercel Node does not use it.
MCA_ASSISTANT_SERVICE_URL=
MCA_ASSISTANT_SIGNING_SECRET=
MCA_ASSISTANT_DOMAIN_KEY=

# Separate Google Calendar consent; enable after staging verification.
MCA_CALENDAR_GOOGLE_ENABLED=false
# Dedicated Google reconciliation consumer. Unset/other values leave cron inert.
MCA_CALENDAR_RUNTIME=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Enable only after a real invitation email and Jotform submission round trip.
MCA_APPLICATION_INVITATION_EMAIL_ENABLED=false

# Two-way email conversations reuse MCA_GOOGLE_SENDER_* and MCA_MICROSOFT_SENDER_*.
# Enable only after migration 0063 and staging provider acceptance. Unset keeps cron off.
MCA_EMAIL_CONVERSATIONS_RUNTIME=
# OAuth callback: ${MCA_APP_ORIGIN}/api/mca/senders/oauth/callback
# Reconnect existing accounts to grant mailbox read access.

# Owner-only platform operations (server-only; enable after migration 0037).
MCA_OPERATIONS_ENABLED=false
MCA_PLATFORM_OWNER_USER_ID=
MCA_MONITOR_TOKEN=
# Supabase monitor secrets; alerts remain disabled until the receiver supports operations_alert.
MCA_MONITOR_DATABASE_URL=
MCA_OPERATIONS_ALERTS_ENABLED=false
MCA_OPERATIONS_ALERT_EMAIL=
# Separate opt-in for billing reconciliation incidents.
MCA_BILLING_RECONCILIATION_ALERTS_ENABLED=false
# Extra recovery incidents; require the existing alert delivery switch separately.
MCA_OPERATIONS_RECOVERY_ALERTS_ENABLED=false
MCA_OPERATIONS_WORKER_STALE_SECONDS=90
MCA_OPERATIONS_QUEUE_AGE_SECONDS=600
MCA_OPERATIONS_QUEUE_AGE_BY_KIND_SECONDS={}
MCA_OPERATIONS_PROVIDER_FAILURES=5
MCA_OPERATIONS_BILLING_FAILURES=1
MCA_OPERATIONS_ASSISTANT_RUNS_PER_HOUR=100
# Platform-admin failed-job inventory and reviewed recovery actions.
MCA_JOB_RECOVERY_ENABLED=false
